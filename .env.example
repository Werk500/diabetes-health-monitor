# Copy this file to .env and adjust the values for your environment.

# Alibaba Cloud DashScope API key
SPRING_AI_DASHSCOPE_API_KEY=your-api-key-here

# MySQL
MYSQL_ROOT_PASSWORD=123456

# Redis
REDIS_PASSWORD=123456

# JWT
JWT_SECRET=diabetes-monitor-jwt-secret-key-2024

# Comma-separated browser origins when frontend is not served from the same origin
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8088
